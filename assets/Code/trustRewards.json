          "Actions": [ "AddMail Current {{ModId}}_mailTrustL2" ]
        },
        "{{ModId}}_TrustRewardL3": {
          "Id": "{{ModId}}_TrustRewardL3",
          "Trigger": "DayStarted",
          "Condition": "PLAYER_HAS_MAIL Current HarveyCareTrust_L3 Received, !PLAYER_HAS_MAIL Current {{ModId}}_mailTrustL3 Any",
          "Actions": [ "AddMail Current {{ModId}}_mailTrustL3" ]
        },
        "{{ModId}}_TrustRewardL4": {
