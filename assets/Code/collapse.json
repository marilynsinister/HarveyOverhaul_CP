  // C#: HarveyOverhaulInjury/EventHandlers/PassOutHandler.cs (RegisterCollapse, ProcessOvernightPassOut, ProcessDeathRevive).
  "Changes": [
    {
      // Ванильная сцена: «кто-то нашёл вас и принёс». Для романа — Харви сам.
      // {0} — имя фермера (игра подставляет через LoadString). Married — у SpousesReactToPlayerDeath.
      // Не skippable: команда hospitaldeath (потеря вещей) должна выполниться.
      "LogName": "Гибель — сцена в клинике (Dating)",
      "Action": "EditData",
      "Target": "Data/Events/Hospital",
      "Priority": "Late",
      "When": {
        "Relationship:Harvey": "Dating"
      },
      "Entries": {
        "PlayerKilled": "none/-100 -100/farmer 20 12 2 Harvey 21 12 3/pause 1500/showFrame 5/message \" ...{0}?\"/pause 1000/message \"Знакомый голос. Тёплая ладонь на лбу.\"/viewport 20 12 true/pause 800/speak Harvey \"Солнышко... ты меня слышишь? Не вставай. Просто открой глаза.$s\"/pause 600/showFrame 0/emote farmer 28/speak Harvey \"Тебя принесли без сознания. Раны я обработал, всё под контролем.$u#$b#Я здесь. Я никуда не уйду.$s\"/pause 500/emote Harvey 28/speak Harvey \"*тихо* Когда открылась дверь и я увидел тебя на носилках... у меня руки дрожали. Впервые за много лет.$s\"/pause 400/speak Harvey \"Сегодня — только покой. Встанешь, когда перестанет кружиться голова.$0#$b#А вечером я зайду к тебе домой. Просто посмотреть, как ты. Хорошо?$l\"/pause 800/action MarkEventSeen Current HarveyOverhaulCare.DeathHospitalDating true/hospitaldeath/end dialogue Harvey \"Не торопись. Я рядом, если закружится голова.$s\""
      }
    },
    {
