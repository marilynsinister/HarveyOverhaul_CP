      "Action": "EditData",
      "Target": "Characters/Dialogue/Marnie",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_Overwork", "Hearts:Marnie": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_Overwork": "Оставь инструмент. Суп на плите.$h#$b#Ты пахнешь сеном и усталостью. Садись.$0"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_Overwork — Gus",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Gus",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_Overwork", "Hearts:Gus": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_Overwork": "Ешь. Не на пустой — усталость хуже.$s#$b#Принесу что-нибудь тёплое.$h"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_Overwork — Linus",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Linus",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_Overwork", "Hearts:Linus": "3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_Overwork": "Даже река останавливается в камнях.$0#$b#Отдых — не лень.$l"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_Overwork — Evelyn",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Evelyn",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_Overwork", "Hearts:Evelyn": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_Overwork": "Солнышко, садись. Печенье не сбежит.$h#$b#Отдых — тоже забота о себе.$0"
      }
    },
    {
