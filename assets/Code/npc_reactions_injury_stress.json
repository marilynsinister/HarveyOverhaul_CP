      "Action": "EditData",
      "Target": "Characters/Dialogue/Robin",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_Overwork", "Hearts:Robin": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_Overwork": "Ты снова на ногах с рассвета.$s#$b#Хоть воду пей. Скажи, что снять с тебя — помогу.$0"
      }
    },
    {
