      "Entries": {
        "HarveyOverhaul_NPCReaction_StormFear": "Гром пугает многих — это не слабость.$0#$b#Я тоже предпочитаю укрытие, когда небо рычит.$l"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_StormFear — Evelyn",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Evelyn",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_StormFear", "Hearts:Evelyn": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_StormFear": "Гроза за окном? Заходи к нам.$h#$b#У камина тепло. Переждём вместе.$0"
      }
    },
