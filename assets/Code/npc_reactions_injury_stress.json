    // ===== A. После травмы =====
    {
      "LogName": "HarveyOverhaul_NPCReaction_InjuryRecent — Robin",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Robin",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_InjuryRecent", "Hearts:Robin": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_InjuryRecent": "Ты сегодня осторожнее обычного — видно по походке.$0#$b#Не таскай тяжёлое одна. Скажешь — помогу.$h"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_InjuryRecent — Marnie",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Marnie",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_InjuryRecent", "Hearts:Marnie": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_InjuryRecent": "Слышала, ты не в форме.$0#$b#Не таскай сегодня тяжёлое — сено и мешки подождут.$h"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_InjuryRecent — Evelyn",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Evelyn",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_InjuryRecent", "Hearts:Evelyn": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_InjuryRecent": "Солнышко, не спеши.$h#$b#Отдых — тоже дело. Я подожду.$0"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_InjuryRecent — George",
      "Action": "EditData",
      "Target": "Characters/Dialogue/George",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_InjuryRecent", "Hearts:George": "3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_InjuryRecent": "Молодёжь думает, что бессмертная.$a#$b#Однажды тело напомнит. Харви хоть смотрит — слушай его.$s"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_InjuryRecent — Linus",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Linus",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_InjuryRecent", "Hearts:Linus": "3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_InjuryRecent": "Тело шепчет, когда пора остановиться.$0#$b#Слыши его — земля подождёт.$l"
      }
    },
    // ===== B. После лечения у Харви =====
    {
      "LogName": "HarveyOverhaul_NPCReaction_AfterTreatment — Robin",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Robin",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_AfterTreatment", "Hearts:Robin": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_AfterTreatment": "Видела, выходишь из клиники — уже ровнее идёшь.$h#$b#Харви знает своё дело. Не спорь с ним сегодня.$0"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_AfterTreatment — Evelyn",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Evelyn",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_AfterTreatment", "Hearts:Evelyn": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_AfterTreatment": "После врача — чай и печенье. Заходи, солнышко.$h#$b#Харви умеет лечить. Я видела, как он за тобой присматривает.$l"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_AfterTreatment — Marnie",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Marnie",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_AfterTreatment", "Hearts:Marnie": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_AfterTreatment": "Ты уже лучше выглядишь.$h#$b#После больницы хочется домашнего — загляни, если голодна.$0"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_AfterTreatment — Gus",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Gus",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_AfterTreatment", "Hearts:Gus": "2,3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_AfterTreatment": "Лёгкий ужин — не ударь по желудку после лечения.$h#$b#Харви знает, что делает. Отдохни.$0"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_AfterTreatment — Linus",
      "Action": "EditData",
      "Target": "Characters/Dialogue/Linus",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_AfterTreatment", "Hearts:Linus": "3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_AfterTreatment": "Тебе полегчало? Хорошо.$h#$b#Принять помощь — тоже сила.$0"
      }
    },
    {
      "LogName": "HarveyOverhaul_NPCReaction_AfterTreatment — George",
      "Action": "EditData",
      "Target": "Characters/Dialogue/George",
      "Priority": "Late + 3",
      "When": { "HasConversationTopic": "HarveyOverhaul_NPCReaction_AfterTreatment", "Hearts:George": "3,4,5,6,7,8,9,10" },
      "Entries": {
        "HarveyOverhaul_NPCReaction_AfterTreatment": "Харви тебя починил? Тогда не ломайся опять.$a#$b#Врач старался — уважай это.$s"
      }
    },

    // ===== C. Нарушение режима =====
