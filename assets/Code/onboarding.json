{
    // Поддержка игрока: письмо-знакомство на 2-й день (план, шкала стресса, не скрывать травмы)
    // и письма «Хорошая неделя» (отправляет C#), визит Харви в дождь (реплики — HarveyOverhaulInjury: RainHouseCallManager).
    "Changes": [
        {
            "Action": "EditData",
            "Target": "Data/Mail",
            "Entries": {
                // «Хорошая неделя» (HarveyStressMeter: GoodWeekService) — 5 из 7 спокойных дней.
                "{{ModId}}_mailGoodWeek_Friend": "@,^^Заметил, что эта неделя у тебя прошла спокойнее. Ты высыпаешься, ешь вовремя и не берёшь на себя лишнего — и это видно.^^Врачам редко приходится писать такие письма. Мне приятно.^Прилагаю травяной сбор — просто так, не по рецепту.^^— Харви%item id (O){{ModId}}_HerbalTea 2 %%[#]Хорошая неделя",
                "{{ModId}}_mailGoodWeek_Dating": "@,^^Ты, наверное, не заметила, а я заметил: целую неделю ты спокойная. Высыпаешься, улыбаешься чаще.^^Я горжусь тобой — не как врач, просто горжусь.^Заварила бы себе сбор вечером? Я положил две порции. Вторая — на случай, если зайду.^^— Твой Харви%item id (O){{ModId}}_HerbalTea 2 %%[#]Хорошая неделя",
                "{{ModId}}_mailGoodWeek_Married": "Солнышко,^^записка на кухонном столе, потому что вслух ты опять скажешь «ничего особенного».^Эта неделя была спокойной. Ты спала, ела и не геройствовала. Это особенное.^^Чайник уже налит. Сбор рядом.^^— Харви%item id (O){{ModId}}_HerbalTea 2 %%[#]Хорошая неделя",
                "{{ModId}}_mailWelcome":"@,^^Добро пожаловать в Пеликан-Таун. Я Харви, местный врач. Работа на ферме тяжелее, чем кажется, поэтому три просьбы:^^1. Поранилась — не скрывай. Мелочь сегодня легко становится осложнением завтра.^2. Тревога и усталость тоже считаются. Сон до одиннадцати, нормальная еда и любимые дела помогают лучше любых таблеток.^3. Я веду для тебя план лечения. Заглядывай в него, когда что-то не так.^^— Доктор Харви^^P.S. Клавиша H — «План Харви». Шкала стресса — рядом с энергией, наведи на неё курсор, чтобы увидеть причины.[#]Письмо от доктора"
            }
        },
        {
            // Визит в дождь (RainHouseCallManager): Харви заходит утром перед клиникой и оставляет травяной сбор.
            "Action": "EditData",
            "Target": "Characters/Dialogue/Harvey",
            "Entries": {
                "HarveyMod_RainHouseCall_Cold_Friend": "*стук в дверь* Доброе утро. Простите, что без предупреждения — шёл в клинику мимо.$u#$b#В такой дождь с простудой лучше никуда не выходить. Вот травяной сбор: две кружки до обеда, и под плед.$0#$b#Если поднимется температура — пришлите за мной. Не терпите.$u",
                "HarveyMod_RainHouseCall_Injury_Friend": "*стук в дверь* Доброе утро. Я по пути в клинику — решил проверить, как вы.$u#$b#В сырость травма ноет сильнее, это нормально. Сегодня — тепло, покой и никаких подвигов под дождём.$0#$b#Вот сбор, он согревает. Увидимся на осмотре.$u",
                "HarveyMod_RainHouseCall_Cold_Dating": "*стук в дверь* Это я. Не вставай — я на минуту.$l#$b#Дождь, а ты простужена... я бы весь день думал только об этом. Вот сбор, заваривай каждые пару часов.$u#$b#Вечером зайду ещё. И да, я проверю, пила ли ты.$h",
                "HarveyMod_RainHouseCall_Injury_Dating": "*стук в дверь* Доброе утро, солнышко. Шёл в клинику и не смог пройти мимо.$l#$b#В дождь старые травмы ноют — не геройствуй сегодня, ладно? Отдыхай.$u#$b#Принёс тебе сбор. Второй пакетик — на вечер, если захочешь, чтобы я зашёл.$h"
            }
        },
        {
            // Повторная травма в течение двух сезонов (MedicalCardManager.OnMainInjuryApplied). На «вы» — до 6 сердец.
            "Action": "EditData",
            "Target": "Characters/Dialogue/Harvey",
            "When": { "Hearts:Harvey": "0,1,2,3,4,5" },
            "Entries": {
                "HarveyMod_RepeatInjury": "Та же травма, что и недавно. Я записал это в вашу карту.$s#$b#Дважды подряд — это уже не случайность. Давайте подумаем, что можно изменить.$u",
                "HarveyMod_RepeatInjury_SprainedAnkle": "Опять лодыжка? По карте — совсем недавно было то же самое.$s#$b#Связки после растяжения слабее. Удобная обувь и никаких прыжков по камням, пожалуйста.$u",
                "HarveyMod_RepeatInjury_DeepCuts": "Снова порезы. Я узнаю почерк шахты.$s#$b#Перчатки и антисептик сразу после подъёма — это правда работает.$u",
                "HarveyMod_RepeatInjury_BurnWounds": "Второй ожог за короткое время.$s#$b#Кожа на старом месте ещё тонкая. Держитесь подальше от огня хотя бы пару недель.$u",
                "HarveyMod_RepeatInjury_FracturedBone": "Снова перелом... Я смотрю на прошлый снимок и не хочу видеть третий.$s#$b#Кость срослась, но не стала крепче. Прошу вас — осторожнее.$u",
                "HarveyMod_RepeatInjury_TornMuscles": "Та же мышца. Она помнит прошлый надрыв.$s#$b#Разминка перед тяжёлой работой — не формальность.$u",
                "HarveyMod_RepeatInjury_BackStrain": "Опять спина. Это уже привычка, а не случайность.$s#$b#Поднимайте тяжести ногами, а не спиной. Я покажу как.$u",
                "HarveyMod_RepeatInjury_BruisedRibs": "Рёбра снова. Вы же только что от этого восстановились.$s#$b#Не геройствуйте с монстрами, пока не окрепнете.$u",
                "HarveyMod_RepeatInjury_Concussion": "Второе сотрясение. Это серьёзно — голова не любит повторов.$a#$b#Шлем, отдых и никакой шахты, пока я не разрешу.$u",
                "HarveyMod_RepeatInjury_Cold": "Опять простуда. Иммунитет ещё не восстановился после прошлой.$s#$b#Тёплая одежда, сон и травяной сбор. И под дождь без нужды не выходите.$u"
            }
        },
        {
            "Action": "EditData",
            "Target": "Characters/Dialogue/Harvey",
            "When": { "Hearts:Harvey": "6,7,8,9,10,11,12,13,14" },
            "Entries": {
                "HarveyMod_RepeatInjury": "Та же травма, что и недавно... Я помню. Я всё помню, что с тобой случается.$s#$b#Давай вместе подумаем, что изменить. Я не хочу записывать это в третий раз.$u",
                "HarveyMod_RepeatInjury_SprainedAnkle": "Опять лодыжка? Та же, что и в прошлый раз.$s#$b#Связки после растяжения слабее. Пообещай мне нормальную обувь и никаких прыжков по камням.$u",
                "HarveyMod_RepeatInjury_DeepCuts": "Снова порезы... Шахта, да?$s#$b#Перчатки. Антисептик сразу, как поднимешься. Я серьёзно — я не хочу шить тебя снова.$u",
                "HarveyMod_RepeatInjury_BurnWounds": "Второй ожог... кожа там ещё тонкая после прошлого.$s#$b#Пожалуйста, держись подальше от огня. Хотя бы ради меня.$u",
                "HarveyMod_RepeatInjury_FracturedBone": "Снова перелом. Я смотрю на прошлый снимок, и у меня руки холодеют.$s#$b#Осторожнее, хорошо? Третьего я не выдержу.$u",
                "HarveyMod_RepeatInjury_TornMuscles": "Та же мышца... Она помнит прошлый надрыв.$s#$b#Разминка перед работой. Я проверю, слышишь?$u",
                "HarveyMod_RepeatInjury_BackStrain": "Опять спина. Это уже привычка, а не случайность.$s#$b#Поднимай ногами, не спиной. Давай я покажу — встань вот так.$h",
                "HarveyMod_RepeatInjury_BruisedRibs": "Рёбра снова... ты же только восстановилась.$s#$b#Не лезь к монстрам, пока не окрепнешь. Пожалуйста.$u",
                "HarveyMod_RepeatInjury_Concussion": "Второе сотрясение. Это очень серьёзно — голова не прощает повторов.$a#$b#Никакой шахты, пока я не разрешу. Это не обсуждается.$u",
                "HarveyMod_RepeatInjury_Cold": "Опять простуда? Ты ещё не окрепла после прошлой.$s#$b#Свитер, сон и сбор. И да, я буду проверять.$h"
            }
        },
        {
            "Action": "EditData",
            "Target": "Data/TriggerActions",
            "Entries": {
                "{{ModId}}_triggerWelcome": {
                    "Id": "{{ModId}}_triggerWelcome",
                    "Trigger": "DayStarted",
                    "Condition": "DAYS_PLAYED 2, !PLAYER_HAS_MAIL Current {{ModId}}_mailWelcome Any",
                    "Actions": [ "AddMail Current {{ModId}}_mailWelcome" ]
                }
            }
        }
    ]
}
