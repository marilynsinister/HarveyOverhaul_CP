{
    // Беременность фермерши (брак с Харви). Подключается из content.json, когда Pregnant = игрок.
    // Темы (topicHarvey*Care, topicHarvey_Pregnancy*) — в dialogues/harvey_pregnancy_topics.json:
    // игра ищет темы только в Characters/Dialogue/Harvey, не в MarriageDialogue.
    // Late + 15 — выше реплик накануне/после праздников (festivalsHarvey.json, Late + 10).
    "Changes": [
        {
            "LogName": "Pregnancy — marriage dialogue (дом, дождь, дети, настроение)",
            "Action": "EditData",
            "Priority": "Late",
            "Target": "Characters/Dialogue/MarriageDialogueHarvey",
            "When": {
                "Pregnant": "@{{playerName}}"
            },
            "Entries": {
                "Rainy_Day_0": "*обнимает со спины, пока по крыше стучит дождь* Сегодня никуда не торопимся, солнышко.$l#$b#Грядки польёт небо. А ты польёшь себя чаем — я уже поставил чайник.$h",
                "Rainy_Day_1": "Слышишь, как стучит по крыше?$l#$b#*кладёт ладонь тебе на живот* Малыш, кажется, тоже слушает.$h#$b#Сегодня — плед, книга и я рядом. На улицу только в сапогах и под моим зонтом.$u",
                "Rainy_Day_2": "Я задёрнул шторы и включил тихую музыку.$l#$b#Ты можешь сколько угодно говорить, что тебе надо в сарай. Я схожу сам — а ты расскажешь мне, что там сделать.$h",
                "Rainy_Day_3": "*заворачивает тебя в толстое одеяло* Вот так, моя девочка.$l#$b#Сырость сейчас тебе ни к чему. Я разожгу камин и принесу носки — тёплые, не спорь.$h",
                "Rainy_Day_4": "Смотри — я принёс мяту и ромашку из клиники, солнышко.$l#$b#*зажигает аромалампу* Ромашка — для сна, мята — от тошноты. А я — просто так.$h",
                "Rainy_Night_0": "*ведёт тебя в спальню, держа за руку* Здесь тише всего, любимая.$l#$b#Ложись. Я останусь, пока ты не уснёшь. И ещё немного после.$h",
                "Rainy_Night_1": "Иди сюда, солнышко.$l#$b#*прижимает твою голову к груди* Слышишь? Только дождь и моё сердце.$h#$b#Оба никуда не денутся до утра.$l",
                "Rainy_Night_2": "Я заварил ромашку — специально для тебя.$l#$b#*подаёт чашку* Пей медленно. Я посижу рядом, пока не допьёшь.$h",
                "Rainy_Night_3": "*зажигает лампу у кровати* Пусть горит до утра, любимая.$l#$b#Если проснёшься ночью — не вставай одна. Разбуди меня. Я серьёзно.$u",
                "Rainy_Night_4": "Дождь до утра — я проверил прогноз.$l#$b#*целует в лоб* Спи. Если малыш начнёт толкаться — я тут, рассказывать ему про самолёты.$h",
                "Indoor_Day_0": "*берёт за руку* Ты — мой центр тяжести, любимая.$l#$b#Поэтому и тебе сейчас нужно равновесие: никаких лестниц и табуреток. Достану сам.$h",
                "Indoor_Day_1": "Завтрак подан, солнышко.$h#$b#*поправляет салфетку* Яйцо, хлеб, творог, фрукты — я всё посчитал. Да, это немного чересчур.$u#$b#Но ты ешь за двоих, а я волнуюсь за троих.$l",
                "Indoor_Day_2": "Читаю про третий триместр. Опять.$h#$b#*целует в лоб* Хочу знать всё раньше, чем это понадобится. Тебе и малышу.$l",
                "Indoor_Day_3": "Джаз, бумаги...$h#$b#*отодвигает документы* Подождут. Ты пришла — значит, перерыв у обоих.$l",
                "Indoor_Day_4": "Раньше ты всё время повторяла «я в порядке».$l#$b#*обнимает* А теперь говоришь, когда устала. Ты даже не представляешь, как это меня успокаивает.$h",
                "Indoor_Night_0": "Устала, солнышко?$s#$b#*массирует плечи* Спина ноет — это нормально. Ненормально — терпеть молча. Говори мне.$l",
                "Indoor_Night_1": "*поправляет одеяло* Отдыхаю, когда вижу, как ты спишь.$l#$b#Медицински не доказано. Но работает.$h",
                "Indoor_Night_2": "Закончила дела, любимая?$h#$b#*подносит чашку* Тогда — чай, ноги на подушку и наш вечерний ритуал.$l",
                "Indoor_Night_3": "Ты бледная. Ложись, пожалуйста.$a#$b#Я проверю пульс и принесу воды. Если станет хуже — едем в клинику, вместе.$l",
                "Indoor_Night_4": "Десять вечера — время отбоя.$a#$b#Я спрятал твой блокнот с планами на завтра. Верну утром, честно.$h#$b#Сон сейчас важнее любого урожая.$l",
                "Outdoor_0": "Я посыпал дорожку песком — чтобы ты не поскользнулась.$l#$b#Далеко не уходи, любимая. Если что — я у курятника.$h",
                "Outdoor_1": "Наша ферма будет хорошим местом для детей, моя девочка.$l#$b#*обнимает* Я уже присмотрел, где поставить качели. Только сколачивать их буду сам.$h",
                "Outdoor_2": "Ты не одна, любимая.$l#$b#Ни на грядках, ни ночью, ни в клинике, когда придёт время. Я буду рядом на каждом шаге.$h",
                "Outdoor_3": "Ты — моя самая любимая пациентка и самая упрямая.$h#$b#Поэтому вот шляпа. И вода. И да, я подожду, пока ты попьёшь.$l",
                "Outdoor_4": "Перерыв каждые полчаса.$a#$b#Я поставил будильник на твои часы. Можешь спорить — но сначала посиди.$l",
                "OneKid_0": "%kid1 спит, ты рядом — а скоро нас станет больше.$l#$b#Я буду беречь вас всех. И, кажется, мне понадобится ещё один блокнот.$h",
                "OneKid_1": "%kid1 уже спрашивает, где будет спать малыш.$h#$b#Я сказал: «рядом с мамой». %kid1 обиделся. Пришлось обещать ещё одну сказку.$l",
                "OneKid_3": "Быть отцом во второй раз... *целует твою ладонь*$l#$b#Страшно так же, как в первый. И так же счастливо.$h",
                "TwoKids_0": "%kid1 и %kid2 уже позавтракали.$h#$b#А теперь очередь мамы — вот, специально для тебя, моя девочка.$l#$action AddItem (O)201 1#$b#Ешь. Я прослежу, чтобы никто не утащил кусочек.$h",
                "TwoKids_1": "Пусть играют сколько хотят.$h#$b#*поправляет детям шапки* Я смотрю за ними. А ты — садись в тень и смотри за мной.$l",
                "TwoKids_2": "Если %kid2 станет пилотом...$h#$b#Научу всему, что знаю про самолёты. И буду волноваться на каждом взлёте.$l",
                "TwoKids_3": "Помнишь, как я боялся тишины в этом доме?$l#$b#*обнимает* Теперь здесь никогда не бывает тихо. И я счастлив, как никогда.$h",
                "Good_0": "Каждое утро просыпаюсь и не верю своему счастью...$l#$b#*целует твои волосы* Ты здесь. И нас скоро будет больше.$h",
                "Good_1": "Ты не просто спасла меня от одиночества, солнышко.$l#$b#Ты подарила мне дом, в котором пахнет хлебом и сеном. И теперь — ещё и малыша.$h",
                "Good_2": "С того дня, как ты переехала, я знал — тебя хочется беречь.$l#$b#*обнимает* Теперь беречь можно официально. И вдвойне.$h",
                "Good_3": "Боже, ты сегодня сияешь, моя девочка!$l#$b#*поправляет воротник* Мне нравится в тебе всё — даже рабочий комбинезон, который скоро не застегнётся.$h",
                "Good_5": "Перечитал нашу медицинскую карту, любимая...$u#$b#Диагноз: всё идёт хорошо. И у тебя, и у малыша.$l#$b#*целует твою руку* Я так и запишу. Крупными буквами.$h",
                "Good_6": "Если с тобой что-то случится...$s#$b#*сжимает твои руки* Нет. Не случится. Я для этого здесь.$l#$b#Просто береги себя немного больше обычного. Ради нас троих.$h",
                "Neutral_2": "Сегодня осмотр в три.$u#$b#Приходи, пожалуйста. Займёт двадцать минут, а мне — спокойствия на неделю.$l",
                "Bad_0": "Ты пропустила вчерашний осмотр.$s#$b#Я не сержусь. Я волнуюсь — сейчас каждый осмотр важен.$u#$b#Давай я сам проверю дома, вечером? Две минуты, чай и манжета.$l",
                "patio_Harvey": "*откладывает журнал* Куда интереснее смотреть, как ты работаешь в саду, солнышко.$l#$b#Только не наклоняйся низко. Покажи, что сорвать, — я сорву.$h",
                "spouseRoom_Harvey": "Разложил лекарства по алфавиту.$a#$b#Синие флаконы не трогай, пожалуйста. Если что-то нужно — скажи, я подам сам.$l",
                "funLeave_Harvey": "Выйду ненадолго, любимая.$h#$b#Если почувствуешь себя плохо — звони сразу. Прибегу быстрее, чем ты договоришь.$l",
                "funReturn_Harvey": "Вернулся, солнышко.$h#$b#*касается твоего лба* Как самочувствие? Ничего не тянет, голова не кружится?$l",
                "jobLeave_Harvey": "Ухожу на смену, любимая.$l#$b#Номер клиники на холодильнике. Звони в любое время — отвечу даже с пациентом на кушетке.$h",
                "jobReturn_Harvey": "Двенадцать пациентов сегодня, солнышко.$s#$b#*целует* Но самый важный приём — вечерний. Садись, проверю давление.$l",
                "spring_1": "Весна — твоё время, солнышко.$h#$b#Но пыльца не дремлет. Вот антигистаминное — безопасное при беременности, я проверил трижды.$u",
                "summer_1": "Крем от солнца — каждые два часа, любимая.$a#$b#*наносит на плечи* Хочешь, буду мазать сам? Я совсем не против.$h",
                "summer_27": "Скоро сезон простуд.$s#$b#Я уже собрал аптечку — только то, что можно тебе сейчас. И мыть руки после рынка, хорошо?$l",
                "fall_1": "Осень — время витаминов.$u#$b#*ставит баночку на тумбочку* Одна утром, после еды. Я спрошу вечером — не обижайся.$l",
                "winter_1": "Зимой кожа сохнет, а живот растёт — вот крем.$l#$b#Каждый вечер — мой массаж. Это не обсуждается. Ну, обсуждается — во время массажа.$h",
                "spring_12": "Завтра праздник яиц, любимая.$h#$b#Пойдём вместе. Корзинку понесу я — ты будешь только находить яйца и смеяться.$l",
                "spring_23": "Завтра танец цветов.$l#$b#*тихо* Я весь месяц тренировался медленный шаг. Специально — чтобы ты не устала.$h",
                "summer_10": "Завтра луау.$h#$b#Я уже договорился с Гасом про тень под навесом и холодный лимонад. Солнце сейчас тебе не друг.$a",
                "fall_15": "Завтра ярмарка, солнышко.$h#$b#Я положу в сумку перекус и воду. И не спорь — там очереди, а ты ешь за двоих.$l",
                "fall_26": "Завтра Канун духов.$0#$b#Скелеты бутафорские, лабиринт тёмный. Пройдём его вместе, держась за руки — или обойдём совсем.$l#$b#Я попросил Гаса приготовить тёплый сидр. Безалкогольный — с мёдом и корицей, как ты любишь.$h",
                "winter_7": "Завтра ледовый праздник?$h#$b#Пойдём. Только три слоя одежды, шерстяные носки и никакого льда под ногами без моей руки.$a",
                "winter_28": "Следующий год будет ещё лучше, моя девочка.$l#$b#*целует в лоб* Потому что в нём будет малыш. И ты. И я — немного более нервный, чем обычно.$h"
            }
        },
        {
            "LogName": "Pregnancy — Харви вне дома (курорт, клиника, салун, праздник, город)",
            "Action": "EditData",
            "Priority": "Late + 15",
            "Target": "Characters/Dialogue/Harvey",
            "When": {
                "Relationship:Harvey": "Married",
                "Pregnant": "@{{playerName}}"
            },
            "Entries": {
                "Resort_Entering": "Солнце здесь коварное, солнышко.$a#$b#Шляпа, вода, тень — и ты отдыхаешь. Обо всём остальном позабочусь я.$l",
                "Resort_Leaving": "Не забыла про крем? Кожа сейчас обгорает быстрее.$a#$b#Дай руку — помажу сам. Я врач, у меня это профессиональное.$h",
                "Resort_Shore": "Я прошёл по пляжу — ни медуз, ни острых ракушек.$l#$b#Гуляй спокойно. Я буду в двух шагах.$h",
                "Resort_Chair": "Отдых — не роскошь, а необходимость. Особенно сейчас.$l#$b#Просто посиди. Я прослежу, чтобы тебя никто не дёргал.$h",
                "Resort_Bar": "Я заказал тебе безалкогольный коктейль. Без льда — живот потом спасибо скажет.$a#$b#Если станет шумно — скажи, уйдём в тень.$l",
                "Hospital_Mon": "Понедельник — день осмотра, солнышко.$u#$b#Ты первая в очереди. Хочу убедиться, что с тобой и малышом всё в порядке.$l",
                "Saloon_Fri": "Пиво сегодня не для тебя, любимая.$u#$b#Я заказал для нас травяной чай. Буду пить солидарно — пусть Гас смеётся.$h",
                "FlowerDance_Accept_Spouse": "Конечно, потанцуем.$l#$b#Медленно, солнышко. Если закружится голова — просто держись за меня, я не отпущу руку.$h",
                "Town4": "Хорошее место для прогулки.$l#$b#Только сделай перерыв на лавке через полчаса. Я засеку.$h",
                "Town8": "Гуляешь одна, любимая?$s#$b#Нет-нет, всё хорошо. Просто... можно я провожу тебя до дома?$l",
                "Town10": "Все смотрят на нас...$l#$b#Пусть смотрят. Ты сегодня такая красивая — уставшая и светлая.$h"
            }
        },
