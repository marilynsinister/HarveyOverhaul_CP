        warp farmer 6 12/
        move farmer 0 -3 1 false/
        move Harvey -1 0 3 false/
        move farmer 1 0 1 false/
        pause 300/
        speak Harvey \"О, @! Заходи. Только тише... слышишь?$h\"/
        message \"Из старого приёмника доносится треск и далёкие голоса.\"/
        speak Harvey \"Это частота диспетчерской Зузу-Сити. Они ведут самолёты на посадку.#$b#Когда день тяжёлый, я просто сижу и слушаю. Кто-то там, наверху, тоже держит курс домой.$0\"/
        pause 500/
        emote farmer 32/
        speak Harvey \"Посидишь со мной немного? Ничего делать не нужно. Просто слушать.$h\"/
