                "{{ModId}}_eventHarveyEveningJournal/Time 1900 2300/GameStateQuery PLAYER_NPC_RELATIONSHIP Current Harvey Dating/GameStateQuery Spiderbuttons.BETAS_NPC_LOCATION Harvey HarveyRoom": "
