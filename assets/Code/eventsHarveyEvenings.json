        end",
                "{{ModId}}_eventHarveyEveningPlanes/Time 1900 2300/Friendship Harvey 1500/GameStateQuery !PLAYER_NPC_RELATIONSHIP Current Harvey Married/GameStateQuery Spiderbuttons.BETAS_NPC_LOCATION Harvey HarveyRoom": "
        continue/
        8 9/
