    "Changes": [
        {
            "Action": "EditData",
            "Target": "Data/Events/HarveyRoom",
            "Entries": {
                "{{ModId}}_eventHarveyEveningRadio/Time 1900 2300/Friendship Harvey 1000/GameStateQuery !PLAYER_NPC_RELATIONSHIP Current Harvey Dating Married/GameStateQuery Spiderbuttons.BETAS_NPC_LOCATION Harvey HarveyRoom": "
        continue/
        8 9/
        farmer 1000 1000 0 Harvey 9 9 3/
        skippable/
