{
  // Фрагменты событий, которые зависят от настройки TraumaBackstory («прошлое фермерши: плен у готоро»).
  // Подставляются в события токенами {{i18n:<ключ>.{{HO_Trauma}}}} / {{i18n:<ключ>.{{HO_TraumaScars}}}}:
  //   HO_Trauma       — on | off
  //   HO_TraumaScars  — first (Харви впервые видит шрамы) | known (уже видел в eventHarveyTraumaExam) | off
  // Значения — тот же сырой текст сценария, что и в events*.json: \" — кавычка, \\ — разделитель quickQuestion.

  // ===== eventHarveyMedicalCheck (дружба) — давление, руки, сердце =====
  // on: Харви ещё не знает о плене — замечает, но не называет и не расспрашивает.
  "trauma.medcheck.friend.on": "\\pause 800\\speak Harvey \"Теперь давление. Манжета сожмёт руку — если станет неприятно, скажи «стоп».$u\"\\pause 300\\emote farmer 28\\pause 500\\speak Harvey \"*сразу ослабляет* Стоп. Я понял.$s#$b#Возьму детскую манжету — она мягче. И буду сжимать медленно.\"\\pause 1200\\speak Harvey \"110\/70... приемлемо.$u\"\\pause 500\\speak Harvey \"Покажи руки... если можно.$s\"\\pause 400\\emote farmer 16\\pause 800\\speak Harvey \"Новые мозоли поверх старых шрамов...$s#$b#*смотрит дольше, чем нужно, но ни о чём не спрашивает* Старые — не от фермы.$s#$b#Я приготовил мазь с алоэ и лидокаином.\"\\addItem 349 1\\pause 1000\\speak Harvey \"Теперь послушаю сердце...$u\"\\pause 1500\\speak Harvey \"Оно бьётся так, будто ты всё ещё от чего-то бежишь.$s\"\\pause 600\\emote farmer 12\\pause 800\\speak Harvey \"Но ты здесь. В безопасности. Я сделаю всё необходимое.$0\"",
  "trauma.medcheck.friend.off": "\\pause 800\\speak Harvey \"Теперь давление. Манжета сожмёт руку — если станет неприятно, скажи «стоп».$u\"\\pause 1200\\speak Harvey \"110\/70... приемлемо.$u\"\\pause 500\\speak Harvey \"Покажи руки...$s\"\\pause 400\\emote farmer 16\\pause 800\\speak Harvey \"Мозоли поверх мозолей. Ты держишь инструмент так, будто он должен отработать за двоих.$s#$b#Я приготовил мазь с алоэ и лидокаином.\"\\addItem 349 1\\pause 1000\\speak Harvey \"Теперь послушаю сердце...$u\"\\pause 1500\\speak Harvey \"Оно бьётся слишком быстро для человека, который просто сидит.$s\"\\pause 600\\emote farmer 12\\pause 800\\speak Harvey \"Ты себя загнала. Дальше — по моему расписанию. Я сделаю всё необходимое.$0\"",

  // ===== eventHarveyMedicalCheck_Dating =====
  "trauma.medcheck.dating.on": "\\pause 800\\speak Harvey \"Теперь давление. Манжета сожмёт руку — если станет неприятно, скажи «стоп».$u\"\\pause 300\\emote farmer 28\\pause 500\\speak Harvey \"*сразу ослабляет* Стоп. Я понял.$s#$b#Возьму детскую манжету — она мягче. И буду сжимать медленно.\"\\pause 1200\\speak Harvey \"110\/70... приемлемо.$u\"\\pause 500\\speak Harvey \"Покажи руки... если можно.$s\"\\pause 400\\emote farmer 16\\pause 800\\speak Harvey \"Новые мозоли поверх старых шрамов...$s#$b#*держит твои ладони чуть дольше, чем нужно, и ни о чём не спрашивает* Старые — не от фермы.$s#$b#Я приготовил мазь с алоэ и лидокаином.\"\\addItem 349 1\\pause 1000\\speak Harvey \"Теперь послушаю сердце...$u\"\\pause 1500\\speak Harvey \"Оно бьётся так, будто ты всё ещё от чего-то бежишь.$s\"\\pause 600\\emote farmer 12\\pause 800\\speak Harvey \"Но ты здесь. В безопасности. Я позабочусь об этом.$l\"",
  "trauma.medcheck.dating.off": "\\pause 800\\speak Harvey \"Теперь давление. Манжета сожмёт руку — если станет неприятно, скажи «стоп».$u\"\\pause 1200\\speak Harvey \"110\/70... приемлемо.$u\"\\pause 500\\speak Harvey \"Покажи руки...$s\"\\pause 400\\emote farmer 16\\pause 800\\speak Harvey \"Мозоли поверх мозолей. Ты держишь инструмент так, будто он должен отработать за двоих.$s#$b#Я приготовил мазь с алоэ и лидокаином.\"\\addItem 349 1\\pause 1000\\speak Harvey \"Теперь послушаю сердце...$u\"\\pause 1500\\speak Harvey \"Оно бьётся слишком быстро для человека, который просто сидит.$s\"\\pause 600\\emote farmer 12\\pause 800\\speak Harvey \"Ты себя загнала. Теперь моя очередь о тебе заботиться.$l\"",

  // ===== eventRescueOperation — фермерша в кустах после удара машиной =====
  // on: гроза возвращает её в плен (прячется от «них»). off: сотрясение и испуг, без флешбека.
  "trauma.rescue.flashback.on": "message \"*отползает глубже* Опасно...\"/pause 1000/speak Harvey \"Что опасно? Я врач, я помогу.$s\"/pause 600/message \"*качает головой* Спрячься... они услышат...\"/pause 1200/speak Lewis \"О чём она говорит?$s\"/pause 400/speak Harvey \"Льюис, отойди. Дай мне поговорить с ней.$a\"/pause 800/move Lewis 0 2 2/move Lewis 2 0 3/animate Harvey false false 500 40 41 40/speak Harvey \"*тихо* @, посмотри на меня. Кто услышит?$s\"/pause 1000/stopAnimation Harvey 41/playSound thunder/emote farmer 28/startJittering/message \"*прижимается к земле, закрывает голову руками* Бомбы!.. Прячься!..\"/pause 1500/emote Harvey 16/speak Harvey \"*замирает* Бомбы...$8#$b#*очень тихо* Для тебя это не гром. Ты слышишь бомбёжку.$s\"/pause 1200/speak Harvey \"Посмотри на меня. Над Долиной только гроза. Здесь никто не бомбит.$s#$b#*медленно протягивает руку* Возьми, если готова. Если нет — я подожду.$0\"/pause 1000/message \"*боится прикосновений* Нет... не трогай...\"/pause 1200/speak Harvey \"Я не сделаю тебе больно. Обещаю.$0#$b#Но мне нужно вытащить тебя отсюда.$a\"/pause 1500/message \"*шёпотом* Ты спрячешься?\"/speak Harvey \"Да, мы спрячемся. В клинике. Там безопасно.$0\"/addConversationTopic topicHarveyThunderBombs 14",
  "trauma.rescue.flashback.off": "message \"*отползает глубже* Не надо... голова...\"/pause 1000/speak Harvey \"Тише. Я врач, я помогу.$s\"/pause 600/message \"*щурится* Всё кружится... где я?..\"/pause 1200/speak Lewis \"Она меня не узнаёт?$s\"/pause 400/speak Harvey \"Похоже на сотрясение. Льюис, отойди. Дай мне поговорить с ней.$a\"/pause 800/move Lewis 0 2 2/move Lewis 2 0 3/animate Harvey false false 500 40 41 40/speak Harvey \"*тихо* @, посмотри на меня. Ты в лесу. Тебя задела машина, но ты жива.$s\"/pause 1000/stopAnimation Harvey 41/playSound thunder/emote farmer 28/startJittering/message \"*вздрагивает от грома и закрывает голову руками*\"/pause 1500/speak Harvey \"*понимающе* Это просто гром.$s#$b#*медленно протягивает руку* Возьми, если готова. Если нет — я подожду.$0\"/pause 1000/message \"*тихо* Голова... не трогай пока...\"/pause 1200/speak Harvey \"Я не сделаю тебе больно. Обещаю.$0#$b#Но мне нужно вытащить тебя из-под дождя.$a\"/pause 1500/message \"*шёпотом* Только не быстро...\"/speak Harvey \"Медленно. В клинику. Там тепло и сухо.$0\"",

  // ===== eventRescueOperation — осмотр спины =====
  // first: Харви впервые видит шрамы и ожоги (eventHarveyTraumaExam не было).
  "trauma.rescue.back.first": "speak Harvey \"Повернись. Нужно проверить, нет ли травм спины.$a\"/pause 800/message \"*замирает, боится*\"/pause 1000/speak Harvey \"Что-то не так? Там тоже болит?$s\"/pause 800/message \"*очень медленно поворачивается спиной*\"/pause 2500/emote Harvey 8/speak Harvey \"*резко втягивает воздух* Что... Боже мой...$8\"/pause 1500/message \"*быстро поворачивается, опускает рубашку*\"/pause 1200/emote Harvey 28/speak Harvey \"@... *дрожащим голосом* Эти шрамы... и ожоги. Кто это сделал?$s\"/pause 1500/message \"*молчит, обнимает себя руками*\"/stopAnimation Harvey 22/pause 1500/positionOffset Harvey 0 -4/pause 500/positionOffset Harvey 0 -4/pause 500/positionOffset Harvey 0 -4/pause 500/positionOffset Harvey 4 0/pause 500/positionOffset Harvey 4 0/pause 500/positionOffset Harvey 4 0/pause 500/speak Harvey \"*подходит ближе* Рёбра срослись неровно. Их ломали — и никто не лечил.$s\"/pause 1200/message \"*качает головой, не может говорить*\"/pause 1500/showFrame Harvey 21/speak Harvey \"*медленно протягивает руки — ждёт, пока ты сама не ответишь* Не нужно ничего говорить. Всё позади. Понимаешь? Всё позади.$0\"/pause 2000/speak Harvey \"*голос становится жёстким* Тот, кто это сделал... если он когда-нибудь появится здесь...$a\"/pause 1500/message \"*прижимается к нему*\"/pause 1200/speak Harvey \"*успокаивается* Прости. Не хотел пугать.$s#$b#*кладёт ладонь на плечо — ненадолго* Ты в безопасности.$0\"/addConversationTopic topicHarveyTraumaReveal 7",
  // known: шрамы он уже видел краем в eventHarveyTraumaExam — теперь видит целиком.
  "trauma.rescue.back.known": "speak Harvey \"Повернись. Нужно проверить, нет ли травм спины.$a\"/pause 800/message \"*замирает, боится*\"/pause 1000/speak Harvey \"*мягче* Я помню, что там. Ты можешь сказать «нет».$s\"/pause 800/message \"*очень медленно поворачивается спиной*\"/pause 2500/emote Harvey 8/speak Harvey \"*тихо выдыхает* Тогда я видел только край...$8\"/pause 1500/message \"*быстро поворачивается, опускает рубашку*\"/pause 1200/emote Harvey 28/speak Harvey \"@... *дрожащим голосом* Я не знал, что их столько.$s\"/pause 1500/message \"*молчит, обнимает себя руками*\"/stopAnimation Harvey 22/pause 1500/positionOffset Harvey 0 -4/pause 500/positionOffset Harvey 0 -4/pause 500/positionOffset Harvey 0 -4/pause 500/positionOffset Harvey 4 0/pause 500/positionOffset Harvey 4 0/pause 500/positionOffset Harvey 4 0/pause 500/speak Harvey \"*подходит ближе* Свежих повреждений на спине нет. Только ушиб.$u\"/pause 1200/message \"*качает головой, не может говорить*\"/pause 1500/showFrame Harvey 21/speak Harvey \"*медленно протягивает руки — ждёт, пока ты сама не ответишь* Всё позади. Понимаешь? Всё позади.$0\"/pause 2000/speak Harvey \"*голос становится жёстким* Те, кто это сделал... сюда они не дотянутся. Я не позволю.$a\"/pause 1500/message \"*прижимается к нему*\"/pause 1200/speak Harvey \"*успокаивается* Прости. Не хотел пугать.$s#$b#*кладёт ладонь на плечо — ненадолго* Ты в безопасности.$0\"",
  // off: шрамов нет — только ушиб.
  "trauma.rescue.back.off": "speak Harvey \"Повернись. Нужно проверить, нет ли травм спины.$a\"/pause 800/message \"*медленно поворачивается спиной*\"/pause 2000/speak Harvey \"*осторожно пальпирует* Ушиб от удара о землю. Позвоночник цел.$u\"/pause 1200/emote Harvey 28/speak Harvey \"@... *голос садится* Ещё полметра — и Льюис вёз бы тебя не ко мне.$s\"/pause 1500/message \"*молчит, обнимает себя руками*\"/stopAnimation Harvey 22/pause 1500/showFrame Harvey 21/speak Harvey \"*подходит ближе* Всё позади. Понимаешь? Всё позади.$0\"/pause 1500/message \"*прижимается к нему*\"/pause 1200/speak Harvey \"*кладёт ладонь на плечо — ненадолго* Ты в безопасности.$0\"",

  // ===== Лесное спасение после грозы (eventsGotoroForestRescue.json) =====
  "trauma.forest.midtrust.on": "Сейчас рядом нет взрывов. Опасности нет.$u",
  "trauma.forest.midtrust.off": "Сейчас рядом никого нет. Опасности нет.$u",
  "trauma.forest.married.on": "Это гроза. Не Готоро.$8",
  "trauma.forest.married.off": "Это просто гроза.$8"
}
